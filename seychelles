import turtle

screen = turtle.Screen()
screen.bgcolor("white")

pen = turtle.Turtle()
pen.speed(0)
pen.hideturtle()

def draw_triangle(colour, x1, y1, x2, y2, x3, y3):
  pen.penup()
  pen.pendown()
  pen.color(colour)
  pen.begin_fill()
  pen.goto(x2, y2)
  pen.goto(x3, y3)
  pen.goto(x1, y1)
  pen.end_fill()
  

left = -300
bottom = -150
right = 300
top = 150

draw_triangle("navy",left, bottom, right, top, left, bottom)
draw_triangle("gold",left, bottom, 0, top, 0, bottom)
draw_triangle("red", left, bottom, right, top, 0, bottom)
draw_triangle("white", left, bottom, right, 0, 0, bottom)
draw_triangle("green", left, bottom, right, bottom, right, 0)
turtle.down()

